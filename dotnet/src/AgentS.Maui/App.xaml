<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AgentS.Maui.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Canvas">#0B121A</Color><Color x:Key="Panel">#111D29</Color>
      <Color x:Key="Outline">#263849</Color><Color x:Key="Accent">#A3E635</Color>
      <Color x:Key="Text">#E8F0F7</Color><Color x:Key="Muted">#94A8BA</Color>
      <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource Canvas}" /></Style>
      <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Text}" /><Setter Property="FontSize" Value="14" /></Style>
      <Style x:Key="Caption" TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="12" /></Style>
      <Style x:Key="SectionTitle" TargetType="Label"><Setter Property="FontSize" Value="18" /><Setter Property="FontAttributes" Value="Bold" /></Style>
      <Style TargetType="Entry"><Setter Property="TextColor" Value="{StaticResource Text}" /><Setter Property="PlaceholderColor" Value="{StaticResource Muted}" /><Setter Property="BackgroundColor" Value="#172635" /><Setter Property="FontSize" Value="14" /></Style>
      <Style TargetType="Editor"><Setter Property="TextColor" Value="{StaticResource Text}" /><Setter Property="PlaceholderColor" Value="{StaticResource Muted}" /><Setter Property="BackgroundColor" Value="#172635" /></Style>
      <Style TargetType="Picker"><Setter Property="TextColor" Value="{StaticResource Text}" /><Setter Property="TitleColor" Value="{StaticResource Muted}" /><Setter Property="BackgroundColor" Value="#172635" /></Style>
      <Style TargetType="Button"><Setter Property="BackgroundColor" Value="#24384A" /><Setter Property="TextColor" Value="{StaticResource Text}" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,10" /><Setter Property="FontSize" Value="13" /></Style>
      <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Accent}" /><Setter Property="TextColor" Value="#152308" /><Setter Property="FontAttributes" Value="Bold" /></Style>
      <Style TargetType="Border"><Setter Property="Stroke" Value="{StaticResource Outline}" /><Setter Property="StrokeShape" Value="RoundRectangle 12" /><Setter Property="BackgroundColor" Value="{StaticResource Panel}" /><Setter Property="Padding" Value="18" /></Style>
      <Style TargetType="Switch"><Setter Property="OnColor" Value="{StaticResource Accent}" /></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
